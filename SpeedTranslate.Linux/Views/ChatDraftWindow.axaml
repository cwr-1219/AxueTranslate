<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SpeedTranslate.Linux.Views.ChatDraftWindow"
        Width="520"
        FontFamily="Noto Sans CJK SC, Microsoft YaHei, WenQuanYi Micro Hei, Inter, sans-serif"
        SizeToContent="Height"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        CanResize="False"
        WindowStartupLocation="Manual"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown">

    <Border Name="WindowBorder"
            Background="#E60A0817"
            BorderBrush="#3D355C"
            BorderThickness="1.2"
            CornerRadius="10"
            Padding="14"
            Margin="10"
            BoxShadow="0 4 20 0 #88000000">

        <Grid RowDefinitions="Auto,Auto,Auto">
            <Grid Grid.Row="0" Margin="0,0,0,10" ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="聊" Foreground="#A855F7" FontWeight="Bold" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock Name="ModelTagText"
                               Text="聊天草稿"
                               Foreground="#94A3B8"
                               FontSize="12"
                               FontWeight="SemiBold" />
                </StackPanel>
                <Button Grid.Column="1"
                        Name="CloseBtn"
                        Content="✕"
                        Click="CloseButton_Click"
                        Foreground="#475569"
                        FontSize="14"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="34"
                        Height="34"
                        VerticalAlignment="Center"
                        Padding="0"
                        Classes="DraftClose" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Name="DraftListScrollViewer"
                          MaxHeight="460"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Name="DraftListPanel" Spacing="10" />
            </ScrollViewer>

            <TextBlock Grid.Row="2"
                       Name="ClipboardHintText"
                       Text="第一条最佳回复已复制到剪贴板"
                       Foreground="#64748B"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />
        </Grid>
    </Border>

    <Window.Styles>
        <Style Selector="Button.DraftClose">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bdr" Background="Transparent" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.DraftClose:pointerover /template/ Border#Bdr">
            <Setter Property="Background" Value="#2A1B4E" />
        </Style>
        <Style Selector="Button.DraftClose:pointerover">
            <Setter Property="Foreground" Value="#EF4444" />
        </Style>

        <Style Selector="Button.DraftAction">
            <Setter Property="Background" Value="#231F3A" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#3D355C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.DraftAction:pointerover">
            <Setter Property="Background" Value="#A855F7" />
            <Setter Property="BorderBrush" Value="#A855F7" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>
</Window>
