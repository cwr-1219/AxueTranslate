<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SpeedTranslate.Linux.ViewModels"
        x:Class="SpeedTranslate.Linux.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AxueTranslate"
        Width="440"
        Height="700"
        MinWidth="440"
        MinHeight="700"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        FontFamily="Noto Sans CJK SC, Microsoft YaHei, WenQuanYi Micro Hei, Inter, sans-serif">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Border Background="#0E0B16" BorderBrush="#2D2547" BorderThickness="1" CornerRadius="12">
        <Grid Margin="15" RowDefinitions="34,Auto,*,Auto">

            <!-- 自定义标题栏 -->
            <Border Grid.Row="0"
                    Name="TitleBar"
                    Background="#161224"
                    CornerRadius="11,11,0,0"
                    Margin="-15,-15,-15,10"
                    PointerPressed="TitleBar_PointerPressed">
                <Grid Margin="15,0" ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="译" Foreground="#A855F7" FontWeight="Bold" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="AxueTranslate" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Classes="TitleBar" Content="─" Click="MinimizeButton_Click" ToolTip.Tip="最小化" />
                        <Button Classes="TitleBar TitleBarClose" Content="✕" Click="CloseButton_Click" ToolTip.Tip="关闭到系统托盘" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 顶部标题 -->
            <StackPanel Grid.Row="1" Margin="0,5,0,15">
                <TextBlock Text="AxueTranslate" Foreground="#F1F5F9" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="后台运行中 · 选中文本按下快捷键自动翻译并替换"
                           Foreground="#64748B" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>

            <!-- 配置卡片区 -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- 卡片一：模型与服务配置 -->
                    <Border Classes="Card">
                        <StackPanel>
                            <TextBlock Text="模型服务" Classes="CardTitle" />

                            <TextBlock Text="选择大模型 API" Classes="Label" />
                            <ComboBox Classes="Modern"
                                      Margin="0,0,0,12"
                                      HorizontalAlignment="Stretch"
                                      SelectedIndex="{Binding SelectedModelIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="DeepSeek" />
                                <ComboBoxItem Content="小米大模型" />
                                <ComboBoxItem Content="自定义模型" />
                            </ComboBox>

                            <TextBlock Text="API 接口地址" Classes="Label" />
                            <TextBox Classes="Input" Margin="0,0,0,12" Text="{Binding ApiUrl, Mode=TwoWay}" />

                            <TextBlock Text="API Key" Classes="Label" />
                            <TextBox Classes="Input" Margin="0,0,0,12" Text="{Binding ApiKey, Mode=TwoWay}" PasswordChar="●" RevealPassword="True" />

                            <TextBlock Text="模型名称 (可手填，或点击右侧获取列表)" Classes="Label" />
                            <Grid ColumnDefinitions="*,8,90">
                                <TextBox Grid.Column="0" Classes="Input" Text="{Binding ModelName, Mode=TwoWay}" />
                                <Button Grid.Column="2" Classes="Secondary"
                                        Content="{Binding FetchModelsButtonText}"
                                        IsEnabled="{Binding !IsFetchingModels}"
                                        Command="{Binding FetchModelsCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 卡片二：触发与语种 -->
                    <Border Classes="Card">
                        <StackPanel>
                            <TextBlock Text="触发与语种" Classes="CardTitle" />

                            <Grid ColumnDefinitions="*,10,*" RowDefinitions="Auto,12,Auto">
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="目标翻译语种" Classes="Label" />
                                    <ComboBox Classes="Modern" HorizontalAlignment="Stretch"
                                              SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="自动双向翻译" />
                                        <ComboBoxItem Content="英语" />
                                        <ComboBoxItem Content="简体中文" />
                                        <ComboBoxItem Content="日语" />
                                        <ComboBoxItem Content="韩语" />
                                        <ComboBoxItem Content="法语" />
                                        <ComboBoxItem Content="德语" />
                                        <ComboBoxItem Content="西班牙语" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="替换热键 (点击录入)" Classes="Label" />
                                    <TextBox Name="HotkeyTextBox"
                                             Classes="Input"
                                             IsReadOnly="True"
                                             Cursor="Hand"
                                             TextAlignment="Center"
                                             Text="{Binding HotkeyDisplay, Mode=OneWay}"
                                             KeyDown="HotkeyTextBox_KeyDown" />
                                    <TextBlock Text="浮窗热键 (点击录入)" Classes="Label" Margin="0,8,0,0" />
                                    <TextBox Name="TooltipHotkeyTextBox"
                                             Classes="Input"
                                             IsReadOnly="True"
                                             Cursor="Hand"
                                             TextAlignment="Center"
                                             Text="{Binding TooltipHotkeyDisplay, Mode=OneWay}"
                                             KeyDown="TooltipHotkeyTextBox_KeyDown" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0"
                                            IsVisible="{Binding IsStyleVisible}">
                                    <TextBlock Text="{Binding StyleLabel}" Classes="Label" />
                                    <ComboBox Classes="Modern" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding StyleOptions}"
                                              SelectedIndex="{Binding StyleIndex, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="触发模式" Classes="Label" />
                                    <CheckBox Classes="Dark" Content="划词翻译 (选中文本触发)"
                                              Margin="0,2,0,5"
                                              IsChecked="{Binding EnableSelectionMode, Mode=TwoWay}" />
                                    <CheckBox Classes="Dark" Content="全选翻译 (未选中时翻译全部)"
                                              IsChecked="{Binding EnableAllTextMode, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 卡片三：聊天模式 -->
                    <Border Classes="Card">
                        <StackPanel>
                            <TextBlock Text="聊天模式" Classes="CardTitle" />

                            <Grid ColumnDefinitions="*,10,*" RowDefinitions="Auto,12,Auto,12,Auto">
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="回复语气" Classes="Label" />
                                    <ComboBox Classes="Modern"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding ChatReplyToneOptions}"
                                              SelectedIndex="{Binding ChatReplyToneIndex, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="缓存上下文热键 (点击录入)" Classes="Label" />
                                    <TextBox Name="ChatDraftHotkeyTextBox"
                                             Classes="Input"
                                             IsReadOnly="True"
                                             Cursor="Hand"
                                             TextAlignment="Center"
                                             Text="{Binding ChatDraftHotkeyDisplay, Mode=OneWay}"
                                             KeyDown="ChatDraftHotkeyTextBox_KeyDown" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="上下文改写热键 (点击录入)" Classes="Label" />
                                    <TextBox Name="ContextRewriteHotkeyTextBox"
                                             Classes="Input"
                                             IsReadOnly="True"
                                             Cursor="Hand"
                                             TextAlignment="Center"
                                             Text="{Binding ContextRewriteHotkeyDisplay, Mode=OneWay}"
                                             KeyDown="ContextRewriteHotkeyTextBox_KeyDown" />
                                </StackPanel>

                                <TextBlock Grid.Row="4"
                                           Grid.ColumnSpan="3"
                                           Text="先选中最近聊天记录并缓存上下文；再选中你的中文回复触发上下文改写，AI 会生成 3 条英文候选并复制第一条"
                                           Foreground="#64748B"
                                           FontSize="12"
                                           LineHeight="18"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 卡片四：摘要与阅读 -->
                    <Border Classes="Card">
                        <StackPanel>
                            <TextBlock Text="摘要与阅读" Classes="CardTitle" />
                            <CheckBox Classes="Dark"
                                      Content="长文本自动生成摘要"
                                      Margin="0,2,0,10"
                                      IsChecked="{Binding EnableAutoSummary, Mode=TwoWay}" />

                            <Grid ColumnDefinitions="*,12,110">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="超过该长度自动摘要" Classes="Label" />
                                    <TextBlock Text="短文本仍正常翻译，浮窗右上角可随时手动摘要"
                                               Foreground="#64748B"
                                               FontSize="12"
                                               LineHeight="18"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBox Grid.Column="2"
                                         Classes="Input"
                                         TextAlignment="Center"
                                         Text="{Binding AutoSummaryMinLength, Mode=TwoWay}" />
                            </Grid>

                            <Border Height="1" Background="#2D2547" Margin="0,14,0,12" />

                            <CheckBox Classes="Dark"
                                      Content="渲染 Markdown 数学公式"
                                      Margin="0,0,0,8"
                                      IsChecked="{Binding EnableMarkdownMathRendering, Mode=TwoWay}" />
                            <CheckBox Classes="Dark"
                                      Content="启用彩色语义标签"
                                      Margin="0,0,0,10"
                                      IsChecked="{Binding EnableMarkdownColorRendering, Mode=TwoWay}" />

                            <Grid ColumnDefinitions="*,12,150">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="颜色渲染模式" Classes="Label" />
                                    <TextBlock Text="开启后模型会输出少量受控标签，浮窗按标签着色"
                                               Foreground="#64748B"
                                               FontSize="12"
                                               LineHeight="18"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <ComboBox Grid.Column="2"
                                          Classes="Modern"
                                          ItemsSource="{Binding MarkdownColorModeOptions}"
                                          SelectedIndex="{Binding MarkdownColorModeIndex, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 卡片五：历史与收藏 -->
                    <Border Classes="Card">
                        <StackPanel>
                            <TextBlock Text="历史与收藏" Classes="CardTitle" />
                            <CheckBox Classes="Dark"
                                      Content="保存翻译历史到本地"
                                      Margin="0,2,0,10"
                                      IsChecked="{Binding EnableTranslationHistory, Mode=TwoWay}" />

                            <Grid ColumnDefinitions="*,10,*" RowDefinitions="Auto,12,Auto">
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="历史保留天数" Classes="Label" />
                                    <TextBox Classes="Input"
                                             TextAlignment="Center"
                                             Text="{Binding HistoryRetentionDays, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="最多保存条数" Classes="Label" />
                                    <TextBox Classes="Input"
                                             TextAlignment="Center"
                                             Text="{Binding MaxHistoryItems, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                                    <TextBlock Text="历史快捷键 (点击录入)" Classes="Label" />
                                    <TextBox Name="HistoryHotkeyTextBox"
                                             Classes="Input"
                                             IsReadOnly="True"
                                             Cursor="Hand"
                                             TextAlignment="Center"
                                             Text="{Binding HistoryHotkeyDisplay, Mode=OneWay}"
                                             KeyDown="HistoryHotkeyTextBox_KeyDown"
                                             Margin="0,0,0,10" />
                                    <TextBlock Text="历史只保存在本机配置目录；收藏条目会优先保留"
                                               Foreground="#64748B"
                                               FontSize="12"
                                               LineHeight="18"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10" />
                                    <Grid ColumnDefinitions="*,10,*">
                                        <Button Grid.Column="0"
                                                Classes="Secondary"
                                                Content="打开历史"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Command="{Binding ShowHistoryCommand}" />
                                        <Button Grid.Column="2"
                                                Classes="Secondary"
                                                Content="清空历史"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Command="{Binding ClearHistoryCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 底部保存按钮 -->
            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <Button Classes="Primary"
                        Content="保存配置并最小化到后台"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding SaveCommand}" />
                <TextBlock Text="双击右下角系统托盘图标可重新打开设置界面"
                           Foreground="#475569" FontSize="12" Margin="0,8,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
